<% content_for :title, "#{@race.name} - Race Overview" %>

<div class="max-w-[1100px] mx-auto px-6" data-controller="race-overview">
  <%= render "shared/hud/breadcrumb", trail: [
        { label: "races", path: races_path },
        { label: @race.slug }
      ] %>

  <%# Header %>
  <section class="pt-2.5 pb-[22px]">
    <h1 class="hud-mono text-[30px] font-bold text-hud-accent mt-2 mb-2 tracking-[0.02em] leading-tight">
      <%= @race.name.upcase %>
    </h1>
    <div class="hud-mono text-[12px] text-hud-ink-dim">
      ◷ <%= @race.race_date.strftime("%B %-d, %Y") %><% if @race.location.present? %> · ⌖ <%= @race.location %><% end %>
    </div>
    <div class="hud-mono text-[12px] text-hud-ink-dim mt-[3px]">
      <span class="text-hud-ink font-medium"><%= @totals[:racers] %></span> racers ·
      <span class="text-hud-ink font-medium"><%= @totals[:finishers] %></span> finished ·
      <span class="text-hud-ink font-medium"><%= @totals[:teams] %></span> teams ·
      <span class="text-hud-ink font-medium"><%= @totals[:categories] %></span> categories
    </div>
  </section>

  <%# Filters %>
  <div class="flex gap-2.5 items-center flex-wrap pb-[18px]">
    <input type="search"
           data-race-overview-target="search"
           data-action="input->race-overview#search"
           placeholder="name, team, or plate #"
           aria-label="Filter categories by racer, team, or plate number"
           autocomplete="off"
           class="hud-input hud-mono flex-1 min-w-[220px]" />
    <div class="flex gap-1.5 flex-wrap">
      <% RacesController::FIELD_FILTERS.each_with_index do |(value, label), i| %>
        <button type="button"
                data-race-overview-target="chip"
                data-action="click->race-overview#filter"
                data-field="<%= value %>"
                aria-pressed="<%= i.zero? %>"
                class="hud-chip">
          <%= label %>
        </button>
      <% end %>
    </div>
  </div>

  <%# Category podiums %>
  <div class="flex flex-col" data-race-overview-target="list">
    <% @category_podiums.each do |entry| %>
      <%= render "races/category_podium", entry: entry %>
    <% end %>
  </div>

  <div data-race-overview-target="emptyState"
       class="hidden hud-mono text-center py-12 px-4 text-hud-ink-dim">
    <div class="text-[13px] mb-3">$ no category matches "<span data-race-overview-target="emptyQuery"></span>"</div>
    <button type="button" data-action="click->race-overview#reset" class="hud-button">clear filters</button>
  </div>

  <div class="hud-mono text-[11px] text-hud-ink-dim tracking-[0.04em] pt-5 border-t border-hud-border">
    $ click a category for full standings, laps and compare
  </div>
</div>
